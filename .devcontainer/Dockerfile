# CodeSandbox decides the Python version from this Dockerfile's FROM line.
# crewai / crewai-tools support Python 3.10-3.13 only (3.14 is not supported),
# so we pin to 3.12.
# To change the version, just edit the tag (3.12) on this line to 3.11 / 3.13 / etc.
FROM mcr.microsoft.com/devcontainers/python:3.12
